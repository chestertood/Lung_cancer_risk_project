        </mxCell>
        <mxCell id="26" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="7" target="8" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="27" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="8" target="9" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Right branch arrows -->
        <mxCell id="28" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="10" target="11" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="29" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="11" target="12" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="30" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="12" target="13" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="31" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="13" target="14" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="32" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="14" target="15" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Left Training → Evaluating (merge) -->
        <mxCell id="33" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="9" target="16" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="172" y="730" />
              <mxPoint x="398" y="730" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Right Training → Evaluating (merge) -->
        <mxCell id="34" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="15" target="16" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="624" y="730" />
              <mxPoint x="398" y="730" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Evaluating → Diamond -->
        <mxCell id="35" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="16" target="17" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Diamond → Build (YES) -->
        <mxCell id="36" value="YES" style="edgeStyle=orthogonalEdgeStyle;html=1;fontColor=#2e7d32;fontStyle=1;fontSize=15;" edge="1" source="17" target="18" parent="1">
